# Copy to .env (git-ignored) and choose your own passwords. docker compose will not start without them.
POSTGRES_USER=hospital
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Password of the sample users admin.user, doctor.user, nurse.user and patient.user.
# Applied when the realm is first imported; later changes are made in the Keycloak admin console.
DEV_USERS_PASSWORD=
# Host port of the API (change if 5117 is already in use).
API_PORT=5117
