<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <!-- ASPIRE010 (Aspire CLI bundle off) stays a visible warning, not an error: turning the bundle on changes how
         the AppHost starts, which is not part of the code analysis gate (QUALITY_GATES G1). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);ASPIRE010</WarningsNotAsErrors>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>HospitalManagement-apphost-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.Keycloak" Version="13.6.5-preview.1.26559.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\api\api.csproj" />
  </ItemGroup>

</Project>
