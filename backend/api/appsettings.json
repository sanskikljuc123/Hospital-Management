{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Keycloak": {
        "Authority": "",
        "Issuer": "",
        "Audience": "hospital-api",
        "RequireHttpsMetadata": true,
        "SwaggerClientId": "hospital-web"
    },
    "Database": {
        "MigrateOnStartup": false,
        "SeedOnStartup": false
    },
    "Cors": {
        "AllowedOrigins": [ "http://localhost:3000" ]
    },
    "Swagger": {
        "Enabled": false
    }
}
